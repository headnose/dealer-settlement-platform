<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.headnose.dsp</groupId>
    <artifactId>dealer-settlement-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Dealer Settlement Platform</name>

    <properties>
        <java.version>17</java.version>
        <!-- AWS SDK for Java v2: S3 client for wire statement attachments (wire-service uploads,
             notification-service downloads). Not managed by Spring Boot, so we import its BOM. -->
        <aws-sdk.version>2.57.3</aws-sdk.version>
        <!-- OpenAPI docs + Swagger UI. springdoc 3.2.x is the line built for Spring Boot 4.1 (3.0.x is for
             Boot 4.0, 2.x for Boot 3). Not managed by Spring Boot, so the version is pinned here. -->
        <springdoc.version>3.2.1</springdoc.version>
    </properties>

    <modules>
        <module>loan-service</module>
        <module>settlement-service</module>
        <module>wire-service</module>
        <module>notification-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Pins every software.amazon.awssdk artifact to one version; modules omit <version>. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- O3: tests write their ECS log file into target/ (deleted by mvn clean), not into the module's
                 logs/ folder that dev runs use. A JVM system property outranks application.yaml in Boot.
                 Version comes from spring-boot-starter-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <logging.file.name>${project.build.directory}/test-logs/${project.artifactId}.json</logging.file.name>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>